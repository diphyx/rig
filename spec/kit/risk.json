{
    "$schema": "./schema.json",
    "rig": 1,
    "area": "risk",
    "description": "risk.max, and the core's own count of lost machines.",
    "cases": [
        {
            "id": "risk/rate-above-max",
            "description": "a published rate above risk.max removes the place",
            "given": {
                "config": {
                    "rig": 1,
                    "app": "app",
                    "providers": [
                        {
                            "name": "a",
                            "can": {
                                "spot": true,
                                "stop": true
                            }
                        },
                        {
                            "name": "b",
                            "can": {
                                "spot": true
                            }
                        }
                    ],
                    "kinds": [
                        {
                            "name": "w",
                            "try": [
                                {
                                    "provider": "a",
                                    "market": ["spot", "demand"],
                                    "types": ["t1", "t2"]
                                },
                                {
                                    "provider": "b",
                                    "market": ["spot"],
                                    "types": ["t3"]
                                }
                            ],
                            "risk": {
                                "max": "10%"
                            }
                        }
                    ]
                },
                "fake": {
                    "a": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "za",
                                "rate": ">20%"
                            },
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "zb"
                            },
                            {
                                "market": "spot",
                                "type": "t2",
                                "zone": "za"
                            },
                            {
                                "market": "demand",
                                "type": "t1",
                                "zone": "za"
                            }
                        ],
                        "answers": {
                            "spot/t1/zb": "ok"
                        }
                    },
                    "b": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t3",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    }
                }
            },
            "steps": [
                {
                    "do": "open"
                },
                {
                    "do": "call",
                    "call": "machine.create",
                    "args": ["w"],
                    "expect": {
                        "events": [
                            {
                                "event": "try",
                                "kind": "w",
                                "place": "a/spot/t1/zb",
                                "answer": "ok"
                            },
                            {
                                "event": "machine:created"
                            }
                        ]
                    }
                }
            ]
        },
