{
    "$schema": "./schema.json",
    "rig": 1,
    "area": "rounds",
    "description": "Lost, recover, recovers, life, found, orphan, close.",
    "cases": [
        {
            "id": "rounds/lost-recover",
            "description": "a lost machine is counted, ended so its provider removes what it left, then replaced",
            "given": {
                "config": {
                    "rig": 1,
                    "app": "app",
                    "providers": [
                        {
                            "name": "a",
                            "can": {
                                "spot": true,
                                "stop": true
                            }
                        },
                        {
                            "name": "b",
                            "can": {
                                "spot": true
                            }
                        }
                    ],
                    "kinds": [
                        {
                            "name": "w",
                            "try": [
                                {
                                    "provider": "a",
                                    "market": ["spot", "demand"],
                                    "types": ["t1", "t2"]
                                },
                                {
                                    "provider": "b",
                                    "market": ["spot"],
                                    "types": ["t3"]
                                }
                            ]
                        }
                    ]
                },
                "fake": {
                    "a": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "za"
                            },
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "zb"
                            },
                            {
                                "market": "spot",
                                "type": "t2",
                                "zone": "za"
                            },
                            {
                                "market": "demand",
                                "type": "t1",
                                "zone": "za"
                            }
                        ],
                        "answers": {
                            "spot/t1/za": ["ok", "ok"]
                        }
                    },
                    "b": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t3",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    }
                }
            },
            "steps": [
                {
                    "do": "open"
                },
                {
                    "do": "call",
                    "call": "machine.create",
                    "args": ["w"]
                },
                {
                    "do": "take-back",
                    "id": "m1"
                },
                {
                    "do": "round",
                    "expect": {
                        "events": [
                            {
                                "event": "machine:lost",
                                "machine": {
                                    "id": "m1"
                                }
                            },
                            {
                                "event": "try",
                                "kind": "w",
                                "place": "a/spot/t1/za",
                                "answer": "ok"
                            },
                            {
                                "event": "machine:recovered",
                                "lost": {
                                    "id": "m1"
                                },
                                "machine": {
                                    "id": "m2"
                                }
                            }
                        ],
                        "fake": {
                            "a": {
                                "ends": ["m1"]
                            }
                        }
                    }
                }
            ]
        },
