                                "spot": true
                            }
                        }
                    ],
                    "kinds": [
                        {
                            "name": "w",
                            "try": [
                                {
                                    "provider": "a",
                                    "market": ["spot", "demand"],
                                    "types": ["t1", "t2"]
                                },
                                {
                                    "provider": "b",
                                    "market": ["spot"],
                                    "types": ["t3"]
                                }
                            ]
                        }
                    ]
                },
                "fake": {
                    "a": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "za"
                            },
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "zb"
                            },
                            {
                                "market": "spot",
                                "type": "t2",
                                "zone": "za"
                            },
                            {
                                "market": "demand",
                                "type": "t1",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    },
                    "b": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t3",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    }
                }
            },
            "steps": [
                {
                    "do": "open",
                    "expect": {
                        "events": [
                            {
                                "event": "guard",
                                "kind": "w",
                                "code": "spot-warn"
                            }
                        ]
                    }
                }
            ]
        },
