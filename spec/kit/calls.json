{
    "$schema": "./schema.json",
    "rig": 1,
    "area": "calls",
    "description": "The app's calls: unknown ids, unsupported calls, end, list.",
    "cases": [
        {
            "id": "calls/unknown-id",
            "description": "an id the store does not hold is a refusal",
            "given": {
                "config": {
                    "rig": 1,
                    "app": "app",
                    "providers": [
                        {
                            "name": "a",
                            "can": {
                                "spot": true,
                                "stop": true
                            }
                        },
                        {
                            "name": "b",
                            "can": {
                                "spot": true
                            }
                        }
                    ],
                    "kinds": [
                        {
                            "name": "d",
                            "try": [
                                {
                                    "provider": "a",
                                    "market": ["demand"],
                                    "types": ["t1"]
                                }
                            ]
                        }
                    ]
                },
                "fake": {
                    "a": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "za"
                            },
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "zb"
                            },
                            {
                                "market": "spot",
                                "type": "t2",
                                "zone": "za"
                            },
                            {
                                "market": "demand",
                                "type": "t1",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    },
                    "b": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t3",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    }
                }
            },
            "steps": [
                {
                    "do": "open"
                },
                {
                    "do": "call",
                    "call": "machine.end",
                    "args": ["zz"],
                    "expect": {
                        "refusal": "unknown"
                    }
                }
            ]
        },
        {
            "id": "calls/end",
            "description": "machine.end ends the machine and emits machine:ended",
            "given": {
                "config": {
                    "rig": 1,
                    "app": "app",
                    "providers": [
                        {
                            "name": "a",
                            "can": {
                                "spot": true,
                                "stop": true
                            }
                        },
                        {
                            "name": "b",
                            "can": {
                                "spot": true
                            }
                        }
                    ],
                    "kinds": [
                        {
                            "name": "d",
                            "try": [
                                {
                                    "provider": "a",
                                    "market": ["demand"],
                                    "types": ["t1"]
                                }
                            ]
                        }
                    ]
                },
                "fake": {
                    "a": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "za"
                            },
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "zb"
                            },
                            {
                                "market": "spot",
                                "type": "t2",
                                "zone": "za"
                            },
                            {
                                "market": "demand",
                                "type": "t1",
                                "zone": "za"
                            }
                        ],
                        "answers": {
                            "demand/t1/za": "ok"
                        }
                    },
                    "b": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t3",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    }
                }
            },
            "steps": [
                {
                    "do": "open"
                },
                {
                    "do": "call",
                    "call": "machine.create",
                    "args": ["d"]
                },
                {
                    "do": "call",
                    "call": "machine.end",
                    "args": ["m1"],
                    "expect": {
                        "events": [
                            {
                                "event": "machine:ended",
                                "machine": {
                                    "id": "m1"
                                }
                            }
                        ],
                        "fake": {
                            "a": {
                                "machines": [
                                    {
                                        "id": "m1",
                                        "status": "ended"
                                    }
                                ]
                            }
                        }
                    }
                }
            ]
        },
