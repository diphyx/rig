{
    "$schema": "./schema.json",
    "rig": 1,
    "area": "open",
    "description": "Opening the core: generation, plugins, config, closed calls.",
    "cases": [
        {
            "id": "open/generation",
            "description": "a config for another generation is a refusal",
            "given": {
                "config": {
                    "rig": 2,
                    "app": "app",
                    "providers": [
                        {
                            "name": "a",
                            "can": {
                                "spot": true,
                                "stop": true
                            }
                        },
                        {
                            "name": "b",
                            "can": {
                                "spot": true
                            }
                        }
                    ],
                    "kinds": [
                        {
                            "name": "d",
                            "try": [
                                {
                                    "provider": "a",
                                    "market": ["demand"],
                                    "types": ["t1"]
                                }
                            ]
                        }
                    ]
                },
                "fake": {
                    "a": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "za"
                            },
                            {
                                "market": "spot",
                                "type": "t1",
                                "zone": "zb"
                            },
                            {
                                "market": "spot",
                                "type": "t2",
                                "zone": "za"
                            },
                            {
                                "market": "demand",
                                "type": "t1",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    },
                    "b": {
                        "places": [
                            {
                                "market": "spot",
                                "type": "t3",
                                "zone": "za"
                            }
                        ],
                        "answers": {}
                    }
                }
            },
            "steps": [
                {
                    "do": "open",
                    "expect": {
                        "refusal": "generation"
                    }
                }
            ]
        },
