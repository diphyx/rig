{
    "name": "rig",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm test:unit",
        "test:unit": "vitest run",
        "lint": "eslint ./ --fix",
        "format": "prettier ./ --write",
        "check": "tsc -b && tsc -p test/e2e && eslint ./ --max-warnings 0 && prettier ./ --check && vitest run",
        "test:e2e": "pnpm build && node --env-file-if-exists=test/e2e/.env test/e2e/host.ts",
        "test:e2e:run": "pnpm build && node --env-file-if-exists=test/e2e/.env test/e2e/run.ts"
    },
    "devDependencies": {
        "@diphyx/eslint-plugin": "^1.3.1",
        "@diphyx/rig": "workspace:^",
        "@diphyx/rig-aws": "workspace:^",
        "@diphyx/rig-azure": "workspace:^",
        "@diphyx/rig-gcp": "workspace:^",
        "@diphyx/rig-grid": "workspace:^",
        "@types/node": "^22.19.19",
        "eslint": "^9.39.4",
        "prettier": "^3.8.3",
        "radash": "^12.1.1",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    },
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=22"
    }
}
