# The e2e tests' sign-in: copy to test/e2e/.env, fill in. Unset, each SDK's own sign-in and region.

# aws: an access key (spec §8.1), and the region (spec §8.2)
RIG_AWS_ID=
RIG_AWS_SECRET=
RIG_AWS_TOKEN=
RIG_AWS_REGION=us-east-1

# gcp: a service-account key's JSON, on one line, in single quotes; its project_id is the project
RIG_GCP_KEY='{"type":"service_account","project_id":"","client_email":"","private_key":""}'
RIG_GCP_REGION=us-central1

# azure: a service principal (spec §8.1), the region (spec §8.2), and the subscription
RIG_AZURE_TENANT=
RIG_AZURE_ID=
RIG_AZURE_SECRET=
RIG_AZURE_REGION=eastus
RIG_AZURE_SUBSCRIPTION=

# The tests: the clouds (aws, gcp, azure), the app name that tags every machine, the distro
RIG_E2E=aws,gcp
RIG_E2E_APP=rig-e2e
RIG_E2E_DISTRO=ubuntu
